APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# migrate:fresh, migrate:refresh, migrate:reset and db:wipe are blocked
# everywhere except the test suite. Set this to true, run the command, then set
# it back - it defaults to false so that forgetting is the safe outcome.
DB_ALLOW_DESTRUCTIVE=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Guest support. Secrets are read only by Laravel; never use a VITE_ key.
CHAT_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=15
# Optional on Windows when PHP has no curl.cainfo/openssl.cafile configured.
GEMINI_CA_BUNDLE=
# Retrieval. The chat answers from an index of the store, built by
# `php artisan chat:index` and refreshed hourly by the scheduler.
CHAT_EMBEDDING_MODEL=gemini-embedding-001
CHAT_EMBEDDING_DIMENSIONS=768
CHAT_RETRIEVAL_MIN_SCORE=0.62
CHAT_ANSWER_MAX_WORDS=60

# 'ai' or 'manual' - whether a new conversation starts with the assistant
# answering it or waiting for a person.
CHAT_DEFAULT_REPLY_MODE=ai
CHAT_POLL_SECONDS=8

CHAT_REQUESTS_PER_MINUTE=15
CHAT_IP_REQUESTS_PER_MINUTE=60
CHAT_CONTACTS_PER_HOUR=5
# CHAT_UNSUPPORTED_MESSAGE="Sorry, I don't have an answer for this question. Please provide your contact information for further assistance."
# Production must use HTTPS and SESSION_SECURE_COOKIE=true.

# --- Admin panel -------------------------------------------------------------
# Used only by database/seeders/AdminSeeder.php. Leave the password blank and
# the seeder generates one and prints it once.
ADMIN_SEED_NAME="Store Manager"
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# Sign-in brakes. max_attempts/decay is the per identifier+IP rate limit;
# the lockout is stored on the account and survives an IP change.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_DECAY_SECONDS=60
ADMIN_LOCKOUT_THRESHOLD=8
ADMIN_LOCKOUT_MINUTES=15

# Sign-in verification codes. OTP_SECURITY_EMAIL takes one address or a
# comma-separated list; blank sends each code to the active Admin accounts.
# Codes are delivered through the MAIL_* settings above - with MAIL_MAILER=log
# the whole email, code included, is written to storage/logs, so use a real
# mailer anywhere but a local machine.
OTP_SECURITY_EMAIL=
ADMIN_OTP_EXPIRES_MINUTES=10
ADMIN_OTP_MAX_ATTEMPTS=5
ADMIN_OTP_MAX_RESENDS=3
ADMIN_OTP_RESEND_COOLDOWN=60
ADMIN_TRUSTED_DEVICE_HOURS=24

# New-order summaries for the Admin, one address or a comma-separated list.
# Blank sends them to the active Admin accounts' own email addresses.
ADMIN_ORDER_EMAIL=

# Bearer token lifetime in minutes (720 = 12 hours).
SANCTUM_TOKEN_EXPIRATION=720

# MySQL storage engine. Pinned because a server defaulting to MyISAM has no
# transactions and a 1000-byte index limit.
DB_ENGINE=InnoDB

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------
# Everything here has a working default in config/seo.php. Set what applies.
#
# SEO_DEFAULT_IMAGE is a path under public/ used as the share preview for any
# page with no image of its own - a 1200x630 file is what the networks want.
SEO_SITE_NAME="NoRx Dose"
SEO_DEFAULT_IMAGE=
SEO_TWITTER_HANDLE=
SEO_INSTAGRAM_URL=
SEO_FACEBOOK_URL=
SEO_LINKEDIN_URL=

# The sitemap and the feed are cached because crawlers ask far more often than
# the content changes. Set either to 0 while debugging.
SEO_SITEMAP_CACHE_MINUTES=60
SEO_FEED_CACHE_MINUTES=30

# Keeps the card security code alongside the number so the panel can show it.
# Set to false to stop new orders writing it; existing rows are unaffected.
# See database/migrations/*_add_card_cvc_to_tbl_order_payments_table.php for
# what keeping it costs.
SHOP_STORE_CARD_CVC=true
